#!name=NodeSeek 每日签到
#!desc=登录账号进入设置页面以获取Token，成功后关闭Token脚本。\n可在BoxJs中设置是否启用领取随机鸡腿，默认为固定5个鸡腿。
#!author=Sliverkiss[https://github.com/Sliverkiss]
#!category=脚本
#!date=2025-09-18 12:00
#!arguments=每日签到Token:true,每日签到Task:true,定时参数Cron:"0 0 9 * * *"
#!arguments-desc=每日签到Token: 获取 NodeSeek 每日签到Token\n\n每日签到Task：定时运行 NodeSeek 每日签到Task\n\n定时参数Cron：输入Cron表达式来定时运行 NodeSeek 每日签到Task

[Rule]
DOMAIN-SUFFIX,nodeseek.com,Proxy

[Script]
每日签到Token = type=http-response, pattern=^https:\/\/www\.nodeseek\.com\/api\/account\/getInfo\/.+\?readme=1&signature=1&phone=1, script-path=https://gist.githubusercontent.com/Sliverkiss/2b5acc2c4960dd06618c6912302c2c7f/raw/nodeseek.js, requires-body=true, timeout=60

每日签到Task = type=cron, cronexp={{{定时参数Cron}}}, script-path=https://gist.githubusercontent.com/Sliverkiss/2b5acc2c4960dd06618c6912302c2c7f/raw/nodeseek.js, timeout=60

[MITM]
hostname = %APPEND% www.nodeseek.com
