#!name=VVebo 时间线修复
#!desc=修复 VVebo 失效的用户时间线和我的页面
#!author=suiyuran[https://github.com/suiyuran], androidcn[https://github.com/androidcn]
#!category=脚本
#!openUrl=https://apps.apple.com/app/id670910957

[Script]
修复时间线 = type=http-request, pattern=^https:\/\/api\.weibo\.cn\/2\/users\/show\?, script-path=https://lvll.de/Surge/JavaScript/VVebo_repair.js

修复时间线 = type=http-request, pattern=^https:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?, script-path=https://lvll.de/Surge/JavaScript/VVebo_repair.js

修复时间线 = type=http-request, pattern=^https:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?, script-path=https://lvll.de/Surge/JavaScript/VVebo_repair.js

修复时间线 = type=http-response, pattern=^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?, script-path=https://lvll.de/Surge/JavaScript/VVebo_repair.js, requires-body=true

修复我的页面 = type=http-response, pattern=^https:\/\/api\.weibo\.cn\/2\/cardlist\?, script-path=https://lvll.de/Surge/JavaScript/VVebo_repair.js, requires-body=true

[MITM]
hostname = %APPEND% api.weibo.cn
